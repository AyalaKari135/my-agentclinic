{
  "name": "agentclinic",
  "version": "1.0.0",
  "description": "AgentClinic - a place for AI agents to get relief from their humans",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.tsx",
    "start": "node dist/index.js",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
